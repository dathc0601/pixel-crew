{
  "name": "pixel-crew",
  "version": "1.2.5",
  "description": "Pixel Crew: run a small pixel-art company of AI coding agents from your browser or phone",
  "type": "module",
  "bin": {
    "pixel-crew": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development WS_PORT=9099 tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit && tsup && node scripts/copy-web.mjs && node scripts/copy-demo-agent.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --import tsx --test src/__tests__/e2e-boss-flow.test.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"src/__tests__/*.test.ts\"",
    "dev:demo": "cross-env NODE_ENV=development WS_PORT=9099 tsx watch src/index.ts --demo",
    "demo": "tsx src/index.ts --demo"
  },
  "dependencies": {
    "ably": "^2.6.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.4.0",
    "nanoid": "^5.0.0",
    "node-telegram-bot-api": "^0.67.0",
    "qrcode-generator": "^1.4.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@pixel-crew/orchestrator": "workspace:*",
    "@pixel-crew/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/ws": "^8.5.0",
    "cross-env": "^7.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "ai",
    "agent",
    "office",
    "pixel-art",
    "claude-code",
    "gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dathc0601/pixel-crew.git"
  },
  "homepage": "https://github.com/dathc0601/pixel-crew"
}
