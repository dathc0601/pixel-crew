{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Pixel Crew",
  "version": "0.2.0",
  "identifier": "dev.pixelcrew.app",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/build-desktop.mjs",
    "beforeDevCommand": "node scripts/dev-servers.mjs"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:; img-src 'self' data: blob: http://localhost:* http://127.0.0.1:*; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:*; frame-src http://localhost:* http://127.0.0.1:*; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'"
    },
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pixel Crew",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "url": "pair"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/": "sidecar/"
    },
    "shortDescription": "A pixel-art office of AI coding agents",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
