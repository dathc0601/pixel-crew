{
  "name": "pixel-crew-root",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter web dev",
    "dev:gateway": "pnpm --filter pixel-crew dev",
    "dev:demo": "pnpm --filter pixel-crew dev:demo",
    "start": "pnpm --filter web build && pnpm --filter pixel-crew start",
    "build": "pnpm -r build",
    "build:release": "pnpm --filter web build && pnpm --filter pixel-crew build",
    "publish:release": "pnpm run build:release && cd apps/gateway && npm publish",
    "lint": "eslint .",
    "dev:desktop": "pnpm --filter pixel-crew-desktop dev",
    "build:desktop": "node scripts/install-desktop.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8"
  }
}
